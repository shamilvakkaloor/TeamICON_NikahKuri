rules_version = '2';

// Member and groom photos. The current groom's photo is the centrepiece of the
// home page and is also copied into the publicRounds projection, so these need
// to be publicly readable — but only the admin may upload.
//
// Role is resolved the same way as in firestore.rules: through the
// email-keyed memberIndex document.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.get(
             /databases/(default)/documents/memberIndex/$(request.auth.token.email.lower())
           ).data.role == 'admin';
    }

    match /members/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
